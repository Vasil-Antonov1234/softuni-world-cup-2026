<main class="create">
  <section id="create">
    <div class="form">
      <h2>⚽ Add Match</h2>
      <form class="create-form" method="POST">
        <label>Home Team</label>
        <input type="text" id="home-team" name="homeTeam" placeholder="e.g. Brazil" value="{{matchData.homeTeam}}" />
        <label>Away Team</label>
        <input type="text" id="away-team" name="awayTeam" placeholder="e.g. Argentina" value="{{matchData.awayTeam}}" />
        <label>Home Goals</label>
        <input type="number" id="home-goals" name="homeGoals" placeholder="0" min="0" value="{{matchData.homeGoals}}" />
        <label>Away Goals</label>
        <input type="number" id="away-goals" name="awayGoals" placeholder="0" min="0" value="{{matchData.awayGoals}}" />
        {{>stageSelectOptions}}
        <label>Venue</label>
        <input type="text" id="venue" name="venue" placeholder="e.g. MetLife Stadium, New York" value="{{matchData.venue}}" />
        <label>Match Date</label>
        <input type="text" id="date" name="date" placeholder="DD/MM/YYYY" value="{{matchData.date}}" />
        <label>Image URL</label>
        <input type="text" id="obs-img" name="imageUrl" placeholder="https://..." value="{{matchData.imageUrl}}" />
        <label>Match Report</label>
        <textarea id="description" name="description" placeholder="Describe the match...">{{matchData.description}}</textarea>
        <button type="submit">Add Match</button>
      </form>
    </div>
  </section>
</main>