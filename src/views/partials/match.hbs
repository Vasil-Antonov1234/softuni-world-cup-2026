<li class="card">
    <img src="{{imageUrl}}" alt="Match" />
    <p class="score">{{homeGoals}} - {{awayGoals}}</p>
    <p><strong>Home:</strong> <span class="home-team">{{homeTeam}}</span></p>
    <p><strong>Away:</strong> <span class="away-team">{{awayTeam}}</span></p>
    <p><strong>Stage:</strong> <span class="stage">{{stage}}</span></p>
    <a class="details-btn" href="/matches/{{id}}/details">Details</a>
</li>