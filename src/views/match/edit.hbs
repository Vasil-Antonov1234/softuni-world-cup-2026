<main class="edit">
  <section id="edit">
    <div class="form">
      <h2>✏️ Edit Match</h2>
      <form class="edit-form" action="#" method="POST">
        <label>Home Team</label>
        <input type="text" id="home-team" name="homeTeam" value="Brazil" />
        <label>Away Team</label>
        <input type="text" id="away-team" name="awayTeam" value="Argentina" />
        <label>Home Goals</label>
        <input type="number" id="home-goals" name="homeGoals" value="3" min="0" />
        <label>Away Goals</label>
        <input type="number" id="away-goals" name="awayGoals" value="2" min="0" />
        <label>Stage</label>
        <select id="stage" name="stage">
          <option selected>Group Stage</option>
          <option>Round of 16</option>
          <option>Quarter-final</option>
          <option>Semi-final</option>
          <option>Final</option>
        </select>
        <label>Venue</label>
        <input type="text" id="venue" name="venue" value="MetLife Stadium, New York" />
        <label>Match Date</label>
        <input type="text" id="date" name="date" value="18/06/2026" />
        <label>Image URL</label>
        <input type="text" id="obs-img" name="imageUrl" value="https://example.com/match.jpg" />
        <label>Match Report</label>
        <textarea id="description" name="description">An electrifying South American derby...</textarea>
        <button type="submit">Save Changes</button>
      </form>
    </div>
  </section>
</main>